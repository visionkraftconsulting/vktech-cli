# vktech configuration — copy to one of:
#   ./.env  (project-local)  |  ~/.config/vktech/.env  |  ~/.vktech.env
# or set $VKTECH_ENV to a custom path. Real environment variables always win.

# Analysis provider API keys (only the ones you set are used):
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional: override the default model id per provider
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-pro
XAI_MODEL=grok-4

# Path to the Claude Code CLI used for `vktech code` (default: claude on PATH)
CLAUDE_BIN=claude

# Optional UI: theme = violet (default) | coral ; NO_COLOR=1 disables color
# VKTECH_THEME=violet
