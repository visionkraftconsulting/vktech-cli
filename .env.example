# vktech configuration — copy to one of:
#   ./.env  (project-local)  |  ~/.config/vktech/.env  |  ~/.vktech.env
# or set $VKTECH_ENV to a custom path. Real environment variables always win.

# Analysis provider API keys (only the ones you set are used):
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional: override the default model id per provider
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-pro
XAI_MODEL=grok-4

# ── Self-hosted vision (zero per-call API cost) ───────────────────────────
# `vktech ask -i img.png "..."` uses a self-hosted Ollama vision model first.
# Point LOCAL_VISION_URL at the Ollama host (a GPU droplet for real speed):
#   LOCAL_VISION_URL=http://<gpu-droplet-ip>:11434
LOCAL_VISION_URL=http://127.0.0.1:11434
LOCAL_VISION_MODEL=llama3.2-vision
# true = ONLY the self-hosted model, never fall back to paid APIs (strict $0).
# false = try local first, then the grok→claude→openai paid cascade.
VKTECH_VISION_LOCAL_ONLY=true
# Or set the full order explicitly:
# VKTECH_VISION_PRIORITY=local,anthropic,openai,xai

# Path to the Claude Code CLI used for `vktech code` (default: claude on PATH)
CLAUDE_BIN=claude

# Optional UI: theme = violet (default) | coral ; NO_COLOR=1 disables color
# VKTECH_THEME=violet
