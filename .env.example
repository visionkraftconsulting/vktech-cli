# vktech configuration — copy to one of:
#   ./.env  (project-local)  |  ~/.config/vktech/.env  |  ~/.vktech.env
# or set $VKTECH_ENV to a custom path. Real environment variables always win.

# Analysis provider API keys (only the ones you set are used):
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Serve OpenAI through the Codex CLI instead of the billed api.openai.com.
# When set to "codex", vktech shells out to `codex exec`; if that CLI is signed
# in with a ChatGPT account (`codex login`), requests use the ChatGPT
# subscription rather than API credits — and OPENAI_API_KEY is not needed.
# OPENAI_BACKEND=codex
# CODEX_BIN=codex   # path to the codex CLI (default: codex on PATH)

# Optional: override the default model id per provider
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-pro
XAI_MODEL=grok-4

# Path to the Claude Code CLI used for `vktech code` (default: claude on PATH)
CLAUDE_BIN=claude

# Optional UI: theme = violet (default) | coral ; NO_COLOR=1 disables color
# VKTECH_THEME=violet
